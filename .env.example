# Vercel environment variables for the review system.
# Copy real values into Vercel → Project → Settings → Environment Variables.
# Never commit real secrets and never expose these in frontend code.

# Required by /api/reviews. Create/copy a current Supabase secret key from
# Settings → API Keys. Server-side only: it writes pending reviews and bypasses RLS.
SUPABASE_SECRET_KEY=

# Legacy fallback only. Existing deployments may temporarily keep the older
# service_role JWT here while migrating to SUPABASE_SECRET_KEY.
# SUPABASE_SERVICE_ROLE_KEY=

# Optional spam protection. Set both this secret and the public site key in
# content-config.js (turnstileSiteKey) to enable Cloudflare Turnstile on the review form.
# Get a pair at https://dash.cloudflare.com/?to=/:account/turnstile
TURNSTILE_SECRET_KEY=
