{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "redirects": [
    { "source": "/:path*", "has": [{ "type": "host", "value": "www.scaleupbiz.co.in" }], "destination": "https://scaleupbiz.co.in/:path*", "permanent": true },
    { "source": "/:path*", "has": [{ "type": "host", "value": "scaleupbiz.vercel.app" }], "destination": "https://scaleupbiz.co.in/:path*", "permanent": true },
    { "source": "/index.html", "destination": "/", "permanent": true }
  ],
  "headers": [
    { "source": "/admin", "headers": [{ "key": "X-Robots-Tag", "value": "noindex, nofollow" }] },
    { "source": "/admin/:path*", "headers": [{ "key": "X-Robots-Tag", "value": "noindex, nofollow" }] },
    { "source": "/review/:path*", "headers": [{ "key": "X-Robots-Tag", "value": "noindex" }] },
    { "source": "/database/:path*", "headers": [{ "key": "X-Robots-Tag", "value": "noindex" }] }
  ],
  "rewrites": [
    { "source": "/admin", "destination": "/admin/index.html" },
    { "source": "/admin/", "destination": "/admin/index.html" }
  ]
}
